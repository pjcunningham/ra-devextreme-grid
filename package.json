{
  "name": "ra-devextreme-grid",
  "version": "0.0.0",
  "description": "DevExpress DevExtreme React DataGrid integration for React-Admin",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite examples/basic",
    "dev:remote-fastapi": "vite examples/remote-fastapi/frontend --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "build:example": "vite build examples/basic --outDir ../../dist-example --emptyOutDir",
    "build:remote-fastapi": "vite build examples/remote-fastapi/frontend --outDir ../../../dist-remote-fastapi --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "peerDependencies": {
    "devextreme": "^26.1.0",
    "devextreme-react": "^26.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-admin": "^5.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "devextreme": "^26.1.4",
    "devextreme-react": "^26.1.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "react": "^19.0.0",
    "react-admin": "^5.15.3",
    "react-dom": "^19.0.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "react",
    "react-admin",
    "devextreme",
    "devextreme-react",
    "datagrid",
    "grid"
  ],
  "author": "Paul Cunningham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjcunningham/ra-devextreme-grid.git"
  },
  "bugs": {
    "url": "https://github.com/pjcunningham/ra-devextreme-grid/issues"
  },
  "homepage": "https://github.com/pjcunningham/ra-devextreme-grid#readme",
  "packageManager": "pnpm@10.20.0"
}
